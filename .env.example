# Copia este fichero a .env y rellena los valores en tu máquina.
# .env está en .gitignore: nunca se sube al repositorio.

# Identidad de git (install.sh crea ~/.gitconfig.local con ellos).
GIT_USER_NAME=
GIT_USER_EMAIL=

# Claves de servicios (opcionales; solo se usan localmente).
GITHUB_TOKEN=
ANTHROPIC_API_KEY=
